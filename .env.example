# Copy to .env.local (dev) or set in Vercel → Project → Settings → Environment Variables
# Supabase: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Used server-side for Supabase Auth invite redirectTo (must match production origin).
# Also used by Vercel preview if set; fallback order: NEXT_PUBLIC_SITE_URL → APP_URL → VERCEL_URL → http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# Optional server alias (e.g. in Docker)
# APP_URL=https://your-production-domain.example

# Supabase Dashboard → Authentication → URL configuration:
# - Site URL: match your app origin
# - Redirect URLs must include:
#     {SITE_URL}/invite/complete
#     {SITE_URL}/reset-password
#     http://localhost:3000/invite/complete
#     http://localhost:3000/reset-password
# - Customize "Invite user" and "Reset password" email templates (branding) in the Dashboard.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_server_only
