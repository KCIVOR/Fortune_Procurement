# Staging Environment Configuration
# Copy this to .env.local when working on staging

# Replace these with your NEW staging Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key_here

# App transactional email (bug + RFQ) is configured in Admin → System Settings (SMTP card).
# Invite / password-reset emails stay in Supabase Dashboard → Authentication → SMTP.

# Site URLs for staging
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
